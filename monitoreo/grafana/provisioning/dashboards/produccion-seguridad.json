{
  "uid": "sistema-alumnos-prod",
  "title": "Sistema Alumnos · Producción (seguridad)",
  "description": "Monitoreo en tiempo real de producción: disponibilidad, versión, logins fallidos y peticiones con patrones de ataque.",
  "tags": [
    "securedev",
    "produccion",
    "seguridad"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Producción arriba",
      "description": "1 = Prometheus lee /metrics de producción",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "up{job=\"produccion\"}",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Versión desplegada",
      "description": "Versión 1.0.<build>+<commit> que desplegó Jenkins (trazabilidad)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "app_info{job=\"produccion\"}",
          "legendFormat": "{{version}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Logins fallidos (últimos 5 min)",
      "description": "Alerta si supera 10 en 2 min (fuerza bruta)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum(increase(login_fallidos_total{job=\"produccion\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Peticiones sospechosas (últimos 5 min)",
      "description": "Parámetros con patrones de SQLi, XSS, path traversal o sin token anti-CSRF",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum(increase(peticiones_sospechosas_total{job=\"produccion\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Logins fallidos por minuto",
      "description": "Un pico de fallidos indica fuerza bruta",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum(increase(login_fallidos_total{job=\"produccion\"}[1m]))",
          "legendFormat": "fallidos",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum(increase(login_exitosos_total{job=\"produccion\"}[1m]))",
          "legendFormat": "exitosos",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Peticiones sospechosas por tipo (por minuto)",
      "description": "sqli, xss, path_traversal, csrf, fuerza_bruta",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum by (tipo) (increase(peticiones_sospechosas_total{job=\"produccion\"}[1m]))",
          "legendFormat": "{{tipo}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Respuestas HTTP por código (req/s)",
      "description": "429 = bloqueos por fuerza bruta, 400 = token anti-CSRF inválido, 5xx = errores",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum by (status) (rate(http_requests_total{job=\"produccion\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tráfico por ruta (req/s)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "sum by (endpoint) (rate(http_requests_total{job=\"produccion\"}[1m]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latencia p95 por ruta",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ev3"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ev3"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket{job=\"produccion\"}[5m])))",
          "legendFormat": "{{endpoint}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
